# Benchmark suite for csv
import "std/bench"
import "../src/lib.alya" as csv

function main()
    let runner = bench_runner("csv Micro-Benchmarks")

    let sample_csv = "id,name,role,department,quote\n1,Alice,Engineer,Core,\"Hello, World\"\n2,Bob,Lead,Infra,\"Speed is \"\"key\"\"\"\n3,Charlie,Designer,Product,\"Simple UI\"\n4,Diana,Manager,Ops,\"Deliver fast\""
    let sample_tsv = "id\tname\trole\tdepartment\n1\tAlice\tEngineer\tCore\n2\tBob\tLead\tInfra\n3\tCharlie\tDesigner\tProduct"

    let sample_rows = [
        ["id", "name", "role", "city"],
        ["1", "Alice", "Developer", "London"],
        ["2", "Bob", "Architect", "Berlin, DE"],
        ["3", "Charlie", "Lead", "Tokyo"]
    ]

    let r1 = {"id": "1", "name": "Alice", "city": "London"}
    let r2 = {"id": "2", "name": "Bob", "city": "Berlin, DE"}
    let r3 = {"id": "3", "name": "Charlie", "city": "Tokyo"}
    let sample_records = [r1, r2, r3]
    let headers = ["id", "name", "city"]

    # 1. Parse CSV
    bench_start(runner, 5000)
    let i = 0
    while i < 5000
        csv::parse_csv(sample_csv)
        i += 1
    end
    bench_stop(runner, "parse_csv() 5k calls")

    # 2. Parse TSV
    bench_start(runner, 5000)
    let j = 0
    while j < 5000
        csv::parse_tsv(sample_tsv)
        j += 1
    end
    bench_stop(runner, "parse_tsv() 5k calls")

    # 3. Stringify Rows
    bench_start(runner, 5000)
    let k = 0
    while k < 5000
        csv::stringify_csv(sample_rows)
        k += 1
    end
    bench_stop(runner, "stringify_csv() 5k calls")

    # 4. Stringify Records
    bench_start(runner, 5000)
    let m = 0
    while m < 5000
        csv::stringify_csv_records(sample_records, headers)
        m += 1
    end
    bench_stop(runner, "stringify_csv_records() 5k calls")

    bench_summary(runner)
end

main()
