# Types and data structures for csv
# Part of the Alya Language package ecosystem (https://github.com/alya-lang)

pub struct CsvOptions
    delimiter
    quote_char
    escape_char
    trim
    skip_empty_lines
    comment_char
    crlf
    always_quote
end

pub function options_new()
    return CsvOptions {
        delimiter: ",",
        quote_char: "\"",
        escape_char: "\"",
        trim: 0,
        skip_empty_lines: 1,
        comment_char: "",
        crlf: 0,
        always_quote: 0
    }
end

pub function options_tsv()
    let opts = options_new()
    opts.delimiter = "\t"
    return opts
end

pub function options_with_delimiter(delim)
    let opts = options_new()
    opts.delimiter = delim
    return opts
end
