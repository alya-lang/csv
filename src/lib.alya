## # csv
##
## RFC-4180 Compliant CSV & TSV Library for Alya.
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).
##
## Provides high-performance CSV and TSV parsing, serialization, record mapping,
## strongly-typed delimiter and quoting enums, and convenient file I/O operations.

import "./types.alya"
import "./core/parser.alya"
import "./core/writer.alya"
import "./io/file.alya"

# ═══════════════════════════════════════════════════════════════
# Options & Configuration Constructors
# ═══════════════════════════════════════════════════════════════

## Creates a default CsvOptions instance configured for standard RFC-4180 CSV.
pub function options() -> CsvOptions
    return options_new()
end

## Creates a CsvOptions instance configured for Tab-Separated Values (TSV).
pub function tsv_options() -> CsvOptions
    return options_tsv()
end

## Creates a CsvOptions instance with a custom delimiter character string.
pub function custom_options(delimiter: string) -> CsvOptions
    return options_with_delimiter(delimiter)
end

# ═══════════════════════════════════════════════════════════════
# Parsing API
# ═══════════════════════════════════════════════════════════════

## Parses CSV/TSV text into a 2D array of string rows.
##
## ### Parameters
## - `text`: Raw input string.
## - `opts`: Optional `CsvOptions` configuration.
##
## ### Returns
## 2D array of string fields.
pub function parse_csv(text, opts = null)
    return parse(text, opts)
end

## Parses TSV (Tab-Separated Values) text into a 2D array of string rows.
##
## ### Parameters
## - `text`: Raw TSV input string.
## - `opts`: Optional `CsvOptions` configuration.
##
## ### Returns
## 2D array of string fields.
pub function parse_tsv(text, opts = null)
    let options = opts
    if options is null
        options = options_tsv()
    else
        options.delimiter = "\t"
    end
    return parse(text, options)
end

## Parses CSV text into an array of Map records using the first row as column header names.
##
## ### Parameters
## - `text`: Raw input string containing header and data rows.
## - `opts`: Optional `CsvOptions` configuration.
##
## ### Returns
## Array of map records.
pub function parse_csv_records(text, opts = null)
    return parse_records(text, opts)
end

## Parses TSV text into an array of Map records using the first row as column header names.
##
## ### Parameters
## - `text`: Raw TSV input string containing header and data rows.
## - `opts`: Optional `CsvOptions` configuration.
##
## ### Returns
## Array of map records.
pub function parse_tsv_records(text, opts = null)
    let options = opts
    if options is null
        options = options_tsv()
    else
        options.delimiter = "\t"
    end
    return parse_records(text, options)
end

# ═══════════════════════════════════════════════════════════════
# Serialization API
# ═══════════════════════════════════════════════════════════════

## Serializes a 2D array of rows into an RFC-4180 CSV string.
##
## ### Parameters
## - `rows`: 2D array of rows and cell values.
## - `opts`: Optional `CsvOptions` configuration.
##
## ### Returns
## Serialized CSV string.
pub function stringify_csv(rows, opts = null) -> string
    return stringify(rows, opts)
end

## Serializes a 2D array of rows into a Tab-Separated Values (TSV) string.
##
## ### Parameters
## - `rows`: 2D array of rows and cell values.
## - `opts`: Optional `CsvOptions` configuration.
##
## ### Returns
## Serialized TSV string.
pub function stringify_tsv(rows, opts = null) -> string
    let options = opts
    if options is null
        options = options_tsv()
    else
        options.delimiter = "\t"
    end
    return stringify(rows, options)
end

## Serializes an array of Map records into an RFC-4180 CSV string with a header line.
##
## ### Parameters
## - `records`: Array of map records.
## - `headers`: Optional array of column header names.
## - `opts`: Optional `CsvOptions` configuration.
##
## ### Returns
## Serialized CSV string.
pub function stringify_csv_records(records, headers = null, opts = null) -> string
    return stringify_records(records, headers, opts)
end

## Serializes an array of Map records into a TSV string with a header line.
##
## ### Parameters
## - `records`: Array of map records.
## - `headers`: Optional array of column header names.
## - `opts`: Optional `CsvOptions` configuration.
##
## ### Returns
## Serialized TSV string.
pub function stringify_tsv_records(records, headers = null, opts = null) -> string
    let options = opts
    if options is null
        options = options_tsv()
    else
        options.delimiter = "\t"
    end
    return stringify_records(records, headers, options)
end

# ═══════════════════════════════════════════════════════════════
# File I/O API
# ═══════════════════════════════════════════════════════════════

## Reads a CSV file and parses its contents into a 2D array of rows.
##
## ### Parameters
## - `path`: File system path to the CSV file.
## - `opts`: Optional `CsvOptions` configuration.
##
## ### Returns
## 2D array of string fields.
pub function read_file_rows(path: string, opts = null)
    return read_csv_file(path, opts)
end

## Reads a CSV file and parses its contents into an array of Map records.
##
## ### Parameters
## - `path`: File system path to the CSV file.
## - `opts`: Optional `CsvOptions` configuration.
##
## ### Returns
## Array of map records.
pub function read_file_records(path: string, opts = null)
    return read_records_file(path, opts)
end

## Serializes a 2D array of rows and writes them to a CSV file.
##
## ### Parameters
## - `path`: Destination file path.
## - `rows`: 2D array of rows and cell values.
## - `opts`: Optional `CsvOptions` configuration.
##
## ### Returns
## Integer write status code.
pub function write_file_rows(path: string, rows, opts = null)
    return write_csv_file(path, rows, opts)
end

## Serializes an array of Map records and writes them to a CSV file with a header row.
##
## ### Parameters
## - `path`: Destination file path.
## - `records`: Array of map records.
## - `headers`: Optional array of column header names.
## - `opts`: Optional `CsvOptions` configuration.
##
## ### Returns
## Integer write status code.
pub function write_file_records(path: string, records, headers = null, opts = null)
    return write_records_file(path, records, headers, opts)
end
