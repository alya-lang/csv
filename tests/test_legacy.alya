# test_legacy.alya - Verify legacy stdlib/csv backward-compatibility aliases
import "std/test"
import "../src/lib.alya" as csv

function main()
    test_suite("CSV Legacy stdlib/csv Compatibility Test Suite")
    let r = runner_new()

    # 1. csv_parse & csv_stringify
    let raw = "id,name,role\n1,Alice,Engineer\n2,Bob,Lead"
    let rows = csv::csv_parse(raw)
    runner_assert_eq(r, len(rows), 3, "csv_parse parsed 3 rows")
    runner_assert_str_eq(r, rows[0][0], "id", "Header 0 is id")
    runner_assert_str_eq(r, rows[1][1], "Alice", "Row 1 is Alice")
    runner_assert_str_eq(r, rows[2][2], "Lead", "Row 2 is Lead")

    let str_out = csv::csv_stringify(rows)
    runner_assert(r, contains(str_out, "Alice"), "csv_stringify contains Alice")
    runner_assert(r, contains(str_out, "Bob"), "csv_stringify contains Bob")

    # 2. csv_parse_records & csv_stringify_records
    let records = csv::csv_parse_records(raw)
    runner_assert_eq(r, len(records), 2, "csv_parse_records parsed 2 records")
    runner_assert_str_eq(r, records[0]["name"], "Alice", "Record 0 name is Alice")
    runner_assert_str_eq(r, records[1]["role"], "Lead", "Record 1 role is Lead")

    let str_rec = csv::csv_stringify_records(["id", "name", "role"], records)
    runner_assert(r, contains(str_rec, "Engineer"), "csv_stringify_records contains Engineer")

    # 3. tsv_parse & tsv_stringify
    let tsv_raw = "col1\tcol2\nval1\tval2"
    let tsv_rows = csv::tsv_parse(tsv_raw)
    runner_assert_eq(r, len(tsv_rows), 2, "tsv_parse parsed 2 rows")
    runner_assert_str_eq(r, tsv_rows[1][0], "val1", "TSV row 1 col 0 is val1")
    runner_assert_str_eq(r, tsv_rows[1][1], "val2", "TSV row 1 col 1 is val2")

    let tsv_str = csv::tsv_stringify(tsv_rows)
    runner_assert(r, contains(tsv_str, "\t"), "tsv_stringify has tabs")

    # 4. tsv_parse_records & tsv_stringify_records
    let tsv_rec = csv::tsv_parse_records(tsv_raw)
    runner_assert_eq(r, len(tsv_rec), 1, "tsv_parse_records parsed 1 record")
    runner_assert_str_eq(r, tsv_rec[0]["col1"], "val1", "TSV record 0 col1 is val1")

    let failed = runner_summary(r)
    if failed > 0
        exit(1)
    end
end

main()
